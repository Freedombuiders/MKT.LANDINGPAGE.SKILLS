<?xml version="1.0" encoding="utf-8"?>
<!--
  RevitLicense.addin — Revit add-in manifest.

  Install: copy this file AND the built RevitLicense.dll (plus its dependencies,
  e.g. BouncyCastle.Cryptography.dll) into:
      %APPDATA%\Autodesk\Revit\Addins\2024\

  The <Assembly> path below is relative to the manifest location. The example
  places the DLL in a "RevitLicense" subfolder next to this .addin file:
      %APPDATA%\Autodesk\Revit\Addins\2024\RevitLicense.addin
      %APPDATA%\Autodesk\Revit\Addins\2024\RevitLicense\RevitLicense.dll
      %APPDATA%\Autodesk\Revit\Addins\2024\RevitLicense\BouncyCastle.Cryptography.dll

  TODO(Windows dev): regenerate the GUIDs below (each must be unique). Keep the
  ClientId stable across releases so user settings persist.
-->
<RevitAddIns>

  <!-- Application: runs once at Revit startup. Builds the ribbon + boots the
       LicenseClient + shows the login dialog if needed. -->
  <AddIn Type="Application">
    <Name>RevitLicense</Name>
    <Assembly>RevitLicense\RevitLicense.dll</Assembly>
    <FullClassName>RevitLicense.App.Application</FullClassName>
    <ClientId>11111111-1111-1111-1111-111111111111</ClientId>
    <VendorId>com.yourcompany.revitlicense</VendorId>
    <VendorDescription>Your Company, https://your-buy-page.example</VendorDescription>
  </AddIn>

  <!-- Sample command: ARC.WallDimension (requires the ARC discipline). -->
  <AddIn Type="Command">
    <Name>ARC.WallDimension</Name>
    <Assembly>RevitLicense\RevitLicense.dll</Assembly>
    <FullClassName>RevitLicense.Commands.WallDimensionCommand</FullClassName>
    <ClientId>22222222-2222-2222-2222-222222222222</ClientId>
    <VendorId>com.yourcompany.revitlicense</VendorId>
    <VendorDescription>Your Company</VendorDescription>
    <VisibilityMode>AlwaysVisible</VisibilityMode>
  </AddIn>

  <!-- Sample command: STR.ColumnRebar (requires the STR discipline). -->
  <AddIn Type="Command">
    <Name>STR.ColumnRebar</Name>
    <Assembly>RevitLicense\RevitLicense.dll</Assembly>
    <FullClassName>RevitLicense.Commands.ColumnRebarCommand</FullClassName>
    <ClientId>33333333-3333-3333-3333-333333333333</ClientId>
    <VendorId>com.yourcompany.revitlicense</VendorId>
    <VendorDescription>Your Company</VendorDescription>
    <VisibilityMode>AlwaysVisible</VisibilityMode>
  </AddIn>

</RevitAddIns>
