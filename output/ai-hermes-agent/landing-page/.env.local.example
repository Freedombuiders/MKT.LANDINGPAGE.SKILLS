# ============================================================
# AI Hermes Agent — biến môi trường (copy file này thành .env.local rồi điền)
# ============================================================

# --- Supabase (lead store) ---------------------------------
# Lấy tại: Supabase Dashboard -> Project Settings -> API
# DÙNG service_role secret (KHÔNG dùng anon key) — server bypass RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiI...service_role...

# --- Sepay (thanh toán VietQR) -----------------------------
# Lấy tại: my.sepay.vn -> Cài đặt -> API & Webhook
SEPAY_WEBHOOK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
SEPAY_BANK_ACCOUNT_NUMBER=1023456789
SEPAY_BANK_NAME=Vietcombank
SEPAY_ACCOUNT_NAME=NGUYEN VAN A

# --- CRM /admin ---------------------------------------------
# Mật khẩu vào trang /admin. Mặc định 123456 — ĐỔI sang chuỗi mạnh khi lên production.
ADMIN_PASSWORD=123456

# --- SMTP (email marketing tab — CHƯA cấu hình) -------------
# Tab "Email marketing" trong /admin cần các biến này. Chạy /biz-email-setup
# để chọn provider (Gmail / Resend SMTP / Brevo / SendGrid...) rồi điền vào đây.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
